# The previous version of this file began with the literal line
#   "Open .gitignore and paste:"
# which git read as a filename pattern, and every *.db rule below it was
# commented out. The result was that yaba.db and an 18 MB YABA-2026.exe were
# both committed.

# Databases. A shared database file guarantees merge conflicts nobody can
# resolve, and it puts real password hashes into the repository.
*.db
*.db-shm
*.db-wal
*.db.lock
*.sqlite
*.sqlite3

# Uploaded receipts belong to whoever is running the app, not in the repo.
# Matched at any depth, because the default is relative to wherever the server
# was started. Safe today: no source directory is called "uploads". Do not name
# a Go package that.
/uploads/
uploads/

# Snapshots default to a "backups" directory beside the database, and `yaba
# restore` moves the database it replaces aside next to the original. All of it
# is real data: receipts archives, set-aside databases, preserved pre-empty
# snapshots and release tarballs included.
*.before-restore-*
/backups/
*-uploads.zip
.yaba-*.tgz

# Build output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
/YABA-2026
/yaba
/yaba-server
/yaba-cli

# Go test and coverage artefacts
*.test
*.prof
coverage.out
coverage.html

# Local configuration. YABA_SESSION_KEY and YABA_GEMINI_KEY belong here, never
# in a commit. .env.example is the one exception, and holds no real values.
.env
.env.local
.env.*
!.env.example

# Editors and OS
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# Vendored dependencies (rebuilt automatically from go.mod/go.sum) and
# non-code documents/presentations that aren't needed to run the project.
vendor/
*.docx
*.doc
*.pdf
*.pptx
*.ppt

# Temporary and scratch files. None of these should ever be intentional
# repository content; this just stops one from being committed by accident.
*.log
*.bak
*.old
*.orig
*.tmp
*.swo
