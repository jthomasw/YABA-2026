# YABA configuration.
#
# Copy to .env and fill in. .gitignore already excludes .env, and nothing in
# here should ever be committed with a real value in it.
#
# The server and the yaba CLI read .env from the directory they are started
# in (or the file named by YABA_ENV_FILE) when they start, so restart the
# server after changing it. A variable set in the real environment wins over
# the file. Save the file as UTF-8 (Notepad: Save As, Encoding: UTF-8).
#
# Most settings below are also a command-line flag of the server (run
# ./yaba-server -h). The flag wins where both are given, which is what lets a
# systemd unit hold the defaults and a one-off invocation override them.
#
# The secrets are the exception: YABA_SESSION_KEY, YABA_SMTP_PASS and
# YABA_GEMINI_KEY are read from the environment only, never a flag, because a
# flag value is visible in the process list to every other user on the machine.
#
# The maintenance CLI (yaba) reads YABA_DB, YABA_UPLOADS, YABA_BACKUP_DIR and
# YABA_BACKUP_KEEP from the environment too, so it finds the same files.
#
# Write values bare: no quotes, and no spaces around the "=". Depending on what
# loads this file (systemd, docker --env-file, a shell), quotes or a stray space
# can end up inside the value, and a key with either in it is simply rejected.
#
# Only YABA_SESSION_KEY genuinely has to be set. Everything else has a working
# default; the ones that matter in production are marked.


# ── required in production ────────────────────────────────────────────────────

# The cookie signing key, from which the cookie encryption key is derived.
#
# Generate one with:
#     openssl rand -base64 32
#
# At least 32 bytes. Unset, the server generates a random key at startup and
# says so in the log -- which works, but signs everybody out on every restart.
# Rotating this deliberately has the same effect, which is how you force every
# session in existence to end.
YABA_SESSION_KEY=

# Mark the session cookie Secure, so a browser will not send it over plain HTTP.
#
# On by default: this is the safe setting for any deployment reachable over
# HTTPS, and forgetting to turn it on was a real risk worth removing. Set it to
# 0 only for local development on http://localhost, where a Secure cookie is
# not sent at all and you would otherwise simply not be able to sign in.
#
# The server warns at startup either way: if YABA_BASE_URL is https:// and
# this is off, or if this is on and YABA_BASE_URL is not https://.
YABA_SECURE_COOKIE=1

# The externally reachable root, used to build the links inside emails.
#
# Deliberately NOT taken from the request's Host header: honouring that would
# let anyone who can reach the server mint a password-reset link pointing at
# their own host.
YABA_BASE_URL=https://yaba.example.com


# The timezone date calculations are done in -- "today", which month a
# transaction lands in, when a recurring bill or paycheck is next due.
#
# Unset, this is the server's own local timezone, which is fine as long as the
# server happens to sit in the same timezone as the household using it. Set it
# explicitly (an IANA name, e.g. America/New_York, Europe/London, Asia/Kolkata)
# for any deployment where that isn't guaranteed -- most cloud servers default
# to UTC, which would file anything logged after evening under the wrong day.
YABA_TIMEZONE=


# ── where things live ─────────────────────────────────────────────────────────

# Address to listen on. The default is 127.0.0.1:8000 -- this machine only --
# which is right when a reverse proxy sits in front, so nothing can reach the
# app except through it. Use :8000 to listen on every interface.
YABA_ADDR=127.0.0.1:8000

# The SQLite database. One file; back it up (see below).
YABA_DB=/var/lib/yaba/yaba.db

# Where uploaded receipts are stored. Not inside the database, and not inside
# the directory the binary is served from.
YABA_UPLOADS=/var/lib/yaba/uploads

# Largest receipt accepted, in megabytes. The request body is bounded at this
# plus a megabyte of headroom for the rest of the form.
YABA_MAX_UPLOAD_MB=15


# ── backups ───────────────────────────────────────────────────────────────────

# Snapshots are taken on a timer while the server runs, and once before any
# pending migration -- a failed pre-migration backup aborts the migration rather
# than risking the schema change without a way back.
#
# Unset, snapshots go to a "backups" directory beside YABA_DB -- the same rule
# for the server and the CLI. Set to "off" to disable them, in which case the
# server warns at startup.
#
# If a backup is refused because a guarded table (users, households, ...) went
# empty and that was deliberate, it is accepted automatically once the state has
# persisted for an hour, or at once with `yaba backup -accept-empty`.
# YABA_BACKUP_ACCEPT_EMPTY=1 does the same for the server; remove it again
# afterwards, or that safety check stays off.
YABA_BACKUP_DIR=/var/backups/yaba
YABA_BACKUP_EVERY=24h
YABA_BACKUP_KEEP=14


# ── email ─────────────────────────────────────────────────────────────────────

# Password resets and invitations. With no SMTP host configured both features
# still work -- an invitation shows as a banner the next time the person signs
# in -- but a reset link cannot be delivered, so nobody who is locked out can
# get back in on their own.
#
# The server must offer encryption (STARTTLS on 587, or TLS on 465); one that
# does not is refused, so a reset link is never sent in plain text. Only a relay
# on this same machine (localhost) may go without.
YABA_SMTP_HOST=
YABA_SMTP_PORT=587
YABA_SMTP_USER=
YABA_SMTP_FROM=YABA <you@example.com>

# The password is read from the environment only, never a flag: a flag value is
# visible in the process list to every other user on the machine.
YABA_SMTP_PASS=

# Development only. With no SMTP configured, this prints each undeliverable
# message to the log IN FULL -- including live password-reset URLs, which are
# bearer tokens for the account. Never set it on a machine whose logs are
# shipped, retained or readable by anyone who should not be able to reset
# somebody else's password.
YABA_MAIL_DEBUG=0


# ── receipt reading (Gemini API) ────────────────────────────────────────────

# With no key set, uploads degrade to queueing the receipt for manual entry
# rather than failing. Setting it means every receipt photo is sent to
# Google's Gemini API to be read -- see the About page in the app, which says
# so. Get a key at https://aistudio.google.com/apikey and paste it after the
# "=" with no quotes and no spaces. Never commit a real key to this file.
YABA_GEMINI_KEY=

# Optional: which Gemini model reads receipts. Defaults to a cheap, fast
# "flash-lite" model, which is plenty for reading a total off a receipt.
# This must be an API model id, not a display name such as "Gemini Flash";
# the server refuses to start with an invalid one.
#YABA_GEMINI_MODEL=gemini-3.1-flash-lite
